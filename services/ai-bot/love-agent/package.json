{
  "name": "@hcengineering/love-agent",
  "version": "0.7.0",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "license": "EPL-2.0",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "docker:build": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_build.sh platformcollective/love-agent",
    "docker:push": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/love-agent",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts && pnpm lint:fix"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.25.10",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-love": "^157.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^15.4.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-secure-coding": "^5.4.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.9.0",
    "@livekit/agents": "^1.7.1",
    "@livekit/rtc-node": "^0.13.34",
    "dotenv": "^16.4.5",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}

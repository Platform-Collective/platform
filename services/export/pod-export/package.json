{
  "name": "@hcengineering/pod-export",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --keep-names=true",
    "docker:build": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_build.sh platformcollective/export",
    "docker:tbuild": "docker build -t platformcollective/export . --platform=linux/amd64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/export",
    "docker:abuild": "docker build -t platformcollective/export . --platform=linux/arm64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/export",
    "docker:staging": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/export staging",
    "docker:push": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/export",
    "format": "format src",
    "run-local": "cross-env ts-node src/index.ts",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "devDependencies": {
    "eslint-config-love": "^155.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "@hcengineering/platform-rig": "workspace:^0.7.21",
    "@tsconfig/node16": "^1.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "@types/jest": "^30.0.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@types/archiver": "^6.0.3",
    "@types/js-yaml": "^4.0.9",
    "cross-env": "~7.0.3"
  },
  "dependencies": {
    "@hcengineering/client": "workspace:^0.7.19",

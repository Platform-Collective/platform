{
  "name": "@hcengineering/pod-worker",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "bundle": "node ../../common/scripts/esbuild.js",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "docker:build": "node ../../common/scripts/bash.js ../../common/scripts/docker_build.sh platformcollective/worker .",
    "docker:tbuild": "docker build -t platformcollective/worker . --platform=linux/amd64 && node ../../common/scripts/bash.js ../../common/scripts/docker_tag_push.sh platformcollective/worker",
    "docker:staging": "node ../../common/scripts/bash.js ../../common/scripts/docker_tag.sh platformcollective/worker staging",
    "docker:push": "node ../../common/scripts/bash.js ../../common/scripts/docker_tag.sh platformcollective/worker",
    "run-local": "node ../../common/scripts/bash.js --script run-local",
    "format": "format src",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "bashScripts": {
    "run-local": "cross-env QUEUE_CONFIG='localhost:19092' REGION='cockroach' ts-node src/index.ts"
  },
  "devDependencies": {
    "eslint-config-love": "^155.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "@tsconfig/node16": "^1.0.4",
    "cross-env": "~7.0.3",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@hcengineering/platform-rig": "workspace:^0.7.21",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@hcengineering/server-process": "workspace:^0.7.0"
  },
  "dependencies": {
    "@hcengineering/kafka": "workspace:^0.7.18",
    "@hcengineering/process": "workspace:^0.7.0",
    "@hcengineering/core": "workspace:^0.7.26",
    "@hcengineering/server-core": "workspace:^0.7.19",
    "postgres": "^3.4.9",
    "dotenv": "^16.4.5"
  }
}

    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },

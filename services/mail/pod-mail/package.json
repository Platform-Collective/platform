{
  "name": "@hcengineering/pod-mail",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js",
    "docker:build": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_build.sh platformcollective/mail",
    "docker:staging": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/mail staging",
    "docker:abuild": "docker build -t platformcollective/mail . --platform=linux/arm64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/mail",
    "docker:push": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/mail",
    "run-local": "ts-node src/index.ts",
    "format": "format src",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "devDependencies": {
    "eslint-config-love": "^157.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "cross-env": "~7.0.3",
    "@hcengineering/platform-rig": "workspace:^0.7.21",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint": "^9.39.5",
    "esbuild": "^0.25.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "@types/jest": "^30.0.0",
    "@tsconfig/node16": "^1.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1107.0",
    "@hcengineering/analytics": "workspace:^0.7.19",
    "@hcengineering/analytics-service": "workspace:^0.7.19",
    "@hcengineering/core": "workspace:^0.7.26",
    "@hcengineering/server-core": "workspace:^0.7.19",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "lru-cache": "^11.1.0",
    "nodemailer": "^9.1.1"
  }
}

{
  "name": "@hcengineering/pod-gitlab",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --sourcemap=external",
    "docker:build": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_build.sh platformcollective/gitlab",
    "docker:staging": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/gitlab staging",
    "docker:push": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/gitlab",
    "docker:tbuild": "rush bundle --to @hcengineering/pod-gitlab && docker build -t platformcollective/gitlab . --platform=linux/amd64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/gitlab",
    "format": "format src",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "devDependencies": {
    "cross-env": "~7.0.3",
    "@hcengineering/platform-rig": "workspace:^0.7.21",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-n": "^15.4.0",
    "eslint": "^8.54.0",
    "esbuild": "^0.25.10",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@types/ws": "^8.18.1",
    "@types/express": "^4.17.13",
    "@types/cors": "^2.8.12",
    "@types/body-parser": "~1.19.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.5"
  },
  "dependencies": {
    "@hcengineering/activity": "workspace:^0.7.0",

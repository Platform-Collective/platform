{
  "name": "@hcengineering/pod-sign",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js",
    "docker:build": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_build.sh platformcollective/sign",
    "docker:tbuild": "docker build -t platformcollective/sign . --platform=linux/amd64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/sign",
    "docker:abuild": "docker build -t platformcollective/sign . --platform=linux/arm64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/sign",
    "docker:staging": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/sign staging",
    "docker:push": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/sign",
    "run-local": "cross-env ts-node src/index.ts",
    "format": "format src",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.21",
    "@tsconfig/node16": "^1.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "@types/jest": "^30.0.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-config-love": "^157.0.0"
  },
  "dependencies": {
    "@hcengineering/server-token": "workspace:^0.7.18",
    "@hcengineering/server-core": "workspace:^0.7.19",
    "@hcengineering/server": "workspace:^0.7.19",
    "@hcengineering/server-storage": "workspace:^0.7.16",
    "@hcengineering/core": "workspace:^0.7.26",
    "@hcengineering/platform": "workspace:^0.7.20",
    "@hcengineering/client": "workspace:^0.7.19",
    "@hcengineering/client-resources": "workspace:^0.7.19",
    "@hcengineering/server-client": "workspace:^0.7.16",
    "@hcengineering/account-client": "workspace:^0.7.25",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "node-forge": "^1.3.3",
    "pdf-lib": "^1.17.1",
    "mongodb": "^6.16.0",
    "@hcengineering/analytics-service": "workspace:^0.7.19"
  }
}
